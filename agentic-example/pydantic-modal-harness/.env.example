# Pydantic AI + Modal Harness - Environment Configuration
# Copy this file to .env and fill in the values.

# --- LLM -------------------------------------------------------------
# Anthropic API key (required for real runs; tests use a stub model)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx
# Pydantic AI model string. Default is Claude Opus 5.
ORCHESTRATOR_MODEL=anthropic:claude-opus-5

# --- Compute backend -------------------------------------------------
# local  : heavy jobs run in-process (no Modal account needed, good for dev/tests)
# modal  : heavy jobs are spawned on Modal (requires `modal token new` + `modal deploy modal_app.py`)
MODAL_MODE=local
MODAL_APP_NAME=agentic-modal-harness
# Simulated latency for local jobs, so the async flow is visible in the UI
LOCAL_JOB_DELAY_SECONDS=2

# --- Result delivery (webhook first, polling fallback) ---------------
# Public URL where Modal can reach this server (e.g. an ngrok/cloudflared tunnel).
# Leave empty to rely on the polling reconciler only.
HARNESS_PUBLIC_URL=
# Shared secret used to HMAC-sign webhook payloads (also stored in the Modal secret)
HARNESS_WEBHOOK_SECRET=change-me-to-a-long-random-string
# How often the reconciler polls Modal for jobs that have not called back yet
RECONCILE_INTERVAL_SECONDS=15
# Do not poll a job before it is at least this old (gives the webhook a chance first)
RECONCILE_GRACE_SECONDS=20

# --- State -----------------------------------------------------------
# memory : fast, lost on restart
# sqlite : durable, in-flight runs survive a restart (reconciler picks them up)
STORE_BACKEND=memory
SQLITE_PATH=harness.db

# --- Observability ---------------------------------------------------
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- Server ----------------------------------------------------------
PORT=8000
