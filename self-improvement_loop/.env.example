# Copy to .env for local runs (the GitHub Action reads these from repo Secrets instead).

# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Market data. Alpha Vantage RECOMMENDED: free key, serves both daily history AND quotes,
# reliable from CI IPs. https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Optional: Finnhub free tier gives a real-time/pre-market quote (history is premium there).
# https://finnhub.io/  -> Dashboard -> API key
FINNHUB_API_KEY=

# If no market-data key is set, the system falls back to keyless yfinance (may be rate-limited
# on cloud/CI IPs); Stooq is a best-effort last resort (now proof-of-work + API-key gated).
